        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff erlauben"
          }
        }
      }
    },
    "Allow Access to App Sound" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff auf den Ton von Apps erlauben"
          }
        }
      }
    },
    "Allow Mixpilot under Login Items in System Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Mixpilot in den Systemeinstellungen unter „Anmeldeobjekte“."
          }
        }
      }
    },
    "Allowed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt"
          }
        }
      }
    },
    "Answer the question from macOS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte die Frage von macOS."
          }
        }
      }
    },
    "Apps" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps"
          }
        }
      }
    },
    "Apps appear here when they play sound." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps werden hier angezeigt, wenn sie Ton wiedergeben."
          }
        }
      }
    },
    "Browsers count when a website uses the microphone, as in a video call." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browser zählen, wenn eine Website das Mikrofon verwendet, etwa bei einem Videoanruf."
          }
        }
      }
    },
    "Call Mode" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrufmodus"
          }
        }
      }
    },
    "Call mode turns on by itself when a call app uses the microphone. You can always turn it on or off in the menu bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anrufmodus schaltet sich von selbst ein, wenn eine Anruf-App das Mikrofon verwendet. In der Menüleiste kannst du ihn jederzeit ein- oder ausschalten."
          }
        }
      }
    },
    "Calls" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrufe"
          }
        }
      }
    },
    "Calls Come First" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrufe haben Vorrang"
          }
        }
      }
    },
    "Changes the volume of the app you’re using in steps of 10 %, up to its own level. Shortcuts work in every app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Lautstärke der App, die du gerade verwendest, in Schritten von 10 %, bis zu ihrer eigenen Lautstärke. Kurzbefehle funktionieren in allen Apps."
          }
        }
      }
    },
    "Continue" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortfahren"
          }
        }
      }
    },
    "Detect Calls In" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrufe erkennen in"
          }
        }
      }
    },
    "Done" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fertig"
          }
        }
      }
    },
    "Every app plays at its own volume and on its own output again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Apps spielen wieder mit ihrer eigenen Lautstärke und über ihre eigene Ausgabe."
          }
        }
      }
    },
    "Forget" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergessen"
