      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allgemein"
          }
        }
      }
    },
    "In Call" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Anruf"
          }
        }
      }
    },
    "In use by %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet von %@."
          }
        }
      }
    },
    "Input Volume" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingangslautstärke"
          }
        }
      }
    },
    "Lower Other Apps During Calls" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Apps bei Anrufen leiser machen"
          }
        }
      }
    },
    "Lowered" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiser"
          }
        }
      }
    },
    "Lowers other apps when a call starts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht andere Apps leiser, wenn ein Anruf beginnt."
          }
        }
      }
    },
    "Microphone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon"
          }
        }
      }
    },
    "Mixpilot is in the menu bar. Click %@ to change the volume of each app. You can set keyboard shortcuts in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixpilot befindet sich in der Menüleiste. Klicke auf %@, um die Lautstärke jeder App zu ändern. Tastaturkurzbefehle kannst du in den Einstellungen festlegen."
          }
        }
      }
    },
    "Mixpilot uses these settings whenever the app plays sound." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixpilot verwendet diese Einstellungen, sobald die App Ton wiedergibt."
          }
        }
      }
    },
    "Mixpilot, Call Mode On" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixpilot, Anrufmodus ein"
          }
        }
      }
    },
    "Mixpilot, Microphone Off" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixpilot, Mikrofon aus"
          }
        }
      }
    },
    "More" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr"
          }
        }
      }
    },
    "Mute" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton aus"
          }
        }
      }
    },
    "Muted" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton aus"
          }
        }
      }
    },
    "Needed to change the volume of apps. Sound is processed on your Mac and is never saved or sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich, um die Lautstärke von Apps zu ändern. Der Ton wird auf deinem Mac verarbeitet und weder gespeichert noch gesendet."
          }
        }
      }
    },
    "No Apps Playing Sound" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine App gibt Ton wieder"
          }
        }
      }
    },
    "No Microphone" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Mikrofon"
          }
        }
      }
    },
    "No Remembered Apps" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine gemerkten Apps"
          }
        }
      }
    },
    "Not Now" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht jetzt"
          }
        }
      }
    },
    "Off for all apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für alle Apps aus."
          }
        }
      }
    },
    "On during your call in %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein während deines Anrufs in %@."
          }
        }
      }
    },
    "On until you turn it off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein, bis du ihn ausschaltest."
          }
        }
      }
    },
    "Open System Settings" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemeinstellungen öffnen"
          }
        }
      }
    },
    "Open at Login" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Anmeldung öffnen"
          }
        }
      }
    },
    "Other Output" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andere Ausgabe"
          }
        }
      }
    },
    "Output" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgabe"
          }
        }
      }
    },
    "Output: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgabe: %@"
          }
        }
      }
    },
    "Permissions" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berechtigungen"
          }
        }
      }
    },
    "Quit Mixpilot" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixpilot beenden"
          }
        }
      }
    },
    "See which apps use it, and turn it off for all of them at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, welche Apps es verwenden, und schalte es für alle auf einmal aus."
          }
        }
      }
    },
    "Set the volume of each app, and keep your calls clear." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle die Lautstärke jeder App ein und höre deine Anrufe klar."
          }
        }
      }
    },
    "Settings…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen …"
          }
        }
      }
    },
    "Shortcuts" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzbefehle"
          }
        }
      }
    },
    "Show in Menu Bar" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Menüleiste anzeigen"
          }
        }
      }
    },
    "System Audio Recording" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemaudioaufnahme"
          }
        }
      }
    },
    "Their own volume stays as you set it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre eigene Lautstärke bleibt, wie du sie eingestellt hast."
          }
        }
      }
    },
    "To change an app’s volume, Mixpilot needs the sound it plays. macOS calls this System Audio Recording. Sound is processed on your Mac and is never saved or sent." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um die Lautstärke einer App zu ändern, braucht Mixpilot den Ton, den sie wiedergibt. macOS nennt das „Systemaudioaufnahme“. Der Ton wird auf deinem Mac verarbeitet und weder gespeichert noch gesendet."
          }
        }
      }
    },
    "To change the volume of apps, allow Mixpilot to record system audio." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Mixpilot die Systemaudioaufnahme, damit du die Lautstärke von Apps ändern kannst."
          }
        }
      }
    },
    "Turn Call Mode On or Off" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anrufmodus ein- oder ausschalten"
          }
        }
      }
    },
    "Turn Down the App in Front" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App im Vordergrund leiser machen"
          }
        }
      }
    },
    "Turn Microphone On or Off" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon ein- oder ausschalten"
          }
        }
      }
    },
    "Turn Up the App in Front" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App im Vordergrund lauter machen"
          }
        }
      }
    },
    "Turn any app down, or send it to other speakers or headphones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach jede App leiser oder schick sie an andere Lautsprecher oder Kopfhörer."
          }
        }
      }
    },
    "Unknown App" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unbekannte App"
          }
        }
      }
    },
    "Unmute" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton ein"
          }
        }
      }
    },
    "Use System Setting" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemeinstellung verwenden"
          }
        }
      }
    },
    "Version" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version"
          }
        }
      }
    },
    "Volume" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke"
          }
        }
      }
    },
    "Volume for Each App" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke für jede App"
          }
        }
      }
    },
    "Volume of Other Apps" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lautstärke anderer Apps"
          }
        }
      }
    },
    "Welcome to Mixpilot" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willkommen bei Mixpilot"
          }
        }
      }
    },
    "When a call starts, other apps get quieter by themselves." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn ein Anruf beginnt, werden andere Apps von selbst leiser."
          }
        }
      }
    },
    "When it’s hidden, open Mixpilot again to see these settings. Your shortcuts keep working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Mixpilot ausgeblendet ist, öffne die App erneut, um diese Einstellungen zu sehen. Deine Kurzbefehle funktionieren weiterhin."
          }
        }
      }
    },
    "When you change an app’s volume or output, Mixpilot remembers it and uses it again the next time the app plays sound." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Lautstärke oder Ausgabe einer App änderst, merkt sich Mixpilot das und verwendet es wieder, sobald die App das nächste Mal Ton wiedergibt."
          }
        }
      }
    },
    "You can allow it later in System Settings ▸ Privacy & Security ▸ Screen & System Audio Recording." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst es später in den Systemeinstellungen unter „Datenschutz & Sicherheit“ ▸ „Bildschirm- & Systemaudioaufnahme“ erlauben."
          }
        }
      }
    },
    "Your Microphone at a Glance" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Mikrofon auf einen Blick"
          }
        }
      }
    },
    "You’re All Set" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bereit"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
